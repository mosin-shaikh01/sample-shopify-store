{% stylesheet %}
  .ms-test-section {
    padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .ms-test-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap }}px;
    align-items: center;
  }

  .ms-test-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
  }

  .ms-test-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ms-test-video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }

  .ms-test-video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ms-test-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ms-test-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  .ms-test-subtext {
    font-size: {{ section.settings.subtext_size }}px;
    line-height: 1.6;
    color: {{ section.settings.subtext_color }};
    margin: 0;
  }

  .ms-test-cta {
    display: inline-block;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-weight: 600;
    font-size: {{ section.settings.button_text_size }}px;
    transition: all 0.3s ease;
    border: 2px solid {{ section.settings.button_bg_color }};
    text-align: center;
    width: fit-content;
  }

  .ms-test-cta:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
    border-color: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .ms-test-container {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    .ms-test-heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.75);
    }

    .ms-test-subtext {
      font-size: calc({{ section.settings.subtext_size }}px * 0.9);
    }

    .ms-test-cta {
      padding: {{ section.settings.button_padding_y | minus: 4 }}px {{ section.settings.button_padding_x | minus: 8 }}px;
      font-size: calc({{ section.settings.button_text_size }}px * 0.9);
    }
  }
{% endstylesheet %}

<section class="ms-test-section">
  <div class="ms-test-container">
    <!-- Media Column -->
    <div class="ms-test-media">
      {% if section.settings.media_type == 'image' %}
        {% if section.settings.image %}
          <img
            src="{{ section.settings.image | image_url: width: 600 }}"
            alt="{{ section.settings.image.alt | escape }}"
            class="ms-test-image"
            loading="lazy"
            width="600"
            height="600"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      {% elsif section.settings.media_type == 'video' %}
        {% if section.settings.video_url != blank %}
          <div class="ms-test-video-container">
            <iframe
              src="{{ section.settings.video_url }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        {% else %}
          <div class="ms-test-video-container">
            {{ 'video' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      {% endif %}
    </div>

    <!-- Content Column -->
    <div class="ms-test-content">
      {% if section.settings.heading != blank %}
        <h2 class="ms-test-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="ms-test-subtext">{{ section.settings.subtext }}</p>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="ms-test-cta">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media + Content",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "placeholder": "https://www.youtube.com/embed/xxx or https://vimeo.com/xxx",
      "info": "YouTube or Vimeo embed URL"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Add your descriptive text here</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button Text Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "label": "Button Horizontal Padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "label": "Button Vertical Padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal Padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap (Desktop)",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Column Gap (Mobile)",
      "min": 0,
      "max": 60,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Media Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Media + Content",
      "settings": {}
    }
  ]
}
{% endschema %}
